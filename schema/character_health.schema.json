{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://sf6-chapter.example.com/schemas/character_health.json",
  "title": "SF6 Character Max Health",
  "description": "キャラクター別の最大体力（ADR-050）。体力ゲージは％のみを記録し、実数値はこの表から表示時に計算する",
  "type": "object",
  "required": ["default", "characters"],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "このファイルが従うJSONスキーマの参照"
    },
    "description": {
      "type": "string",
      "description": "この表の説明と出典"
    },
    "default": {
      "type": "integer",
      "description": "表に無いキャラクターに適用する最大体力",
      "minimum": 1
    },
    "characters": {
      "type": "object",
      "description": "正規名（config/character_aliases.json の canonical）→ 最大体力",
      "patternProperties": {
        "^[A-Za-z0-9._ -]+$": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
